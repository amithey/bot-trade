# Don't bake host data into the image — bind-mount it instead.
data/
logs/

# Python build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets — never copy .env into the image. Compose mounts via env_file.
.env
.env.*
!.env.example

# Streamlit secrets hold the OIDC client_secret and cookie_secret. Baking them
# into the image would ship your OAuth credentials to anyone who can pull it.
# Mount the file at runtime instead (compose: a volume or a secret).
.streamlit/secrets.toml

# Agent / editor tooling config — no reason to ship it.
.claude/

# VCS
.git/
.gitignore

# Frontend builds, if any
node_modules/

# Tests / docs
tests/
docs/
*.md
!README.md
!DEPLOY.md

# Misc
*.log
*.bak
*.swp
