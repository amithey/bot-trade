# =============================================================================
# BotTrade — Environment Variables
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# =============================================================================

# --- Anthropic / Claude API ---
# Get your key from https://console.anthropic.com/settings/keys
#
# In the hosted product this is the OPERATOR's key. It funds nothing but the
# free tier's small taster budget (BOTTRADE_FREE_BUDGET_USD below) — paying
# users bring their own key through Settings and their tokens bill to them.
# Leaving it unset is fully supported: every user then must bring a key, and
# COMMITTEE mode (38 indicators, zero API calls) still works for everyone.
ANTHROPIC_API_KEY=sk-ant-api03-PASTE_YOUR_KEY_HERE

# --- LLM Model Selection ---
# Recommended: claude-haiku-4-5-20251001 for the live loop (fast & cheap)
#              claude-sonnet-4-6           for deeper reasoning when needed
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1            # Low temperature for deterministic trading decisions

# --- Boardroom: a model per seat ---
# BOARDROOM fires ~9 calls per cycle (8 analysts + the chairman), so running
# every seat on one model means an upgrade costs nine times as much. Each
# analyst returns one structured vote from a narrow packet and stays cheap;
# the chairman weighs the whole transcript and casts the binding ruling, so
# that is the seat worth spending on.
#
# Measured at ~4k input / 400 output per call:
#   9x Haiku 4.5              $0.054 / cycle
#   9x Sonnet 5               $0.108 / cycle
#   8x Haiku + Sonnet chair   $0.060 / cycle   <- 44% cheaper, same chair
#
# Both default to LLM_MODEL when unset, which keeps a single-model setup
# behaving exactly as before.
# LLM_MODEL_ANALYST=claude-haiku-4-5-20251001
# LLM_MODEL_CHAIR=claude-sonnet-5

# --- Embeddings ---
# Uses local sentence-transformers — no API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=trading_strategies

# --- Chunking Strategy ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# =============================================================================
# Deployment / Infra
# =============================================================================

# --- Environment ---
# dev | staging | production. Production silences debug expanders,
# nudges toward external notifications, and tightens defaults.
BOTTRADE_ENV=dev

# --- Auth gate (Streamlit dashboard) ---
# Leave the hash UNSET for local development — the dashboard skips the
# login form and serves directly. For any cloud deployment, generate a
# hash with the command below and set BOTTRADE_AUTH_PASSWORD_HASH.
#
#   python -m dashboard._auth
#
# It prints the line to paste below. The PBKDF2 hash carries its own random
# salt, so BOTTRADE_AUTH_HASH_SALT is only for legacy SHA-256 hashes.
#
# Note this gate controls ACCESS, not IDENTITY: everyone who knows the
# password shares one account and one budget. For per-person accounts use
# OIDC sign-in instead - DEPLOY.md section 2b.
# BOTTRADE_AUTH_PASSWORD_HASH=
# BOTTRADE_AUTH_HASH_SALT=

# --- Port (compose maps this to the host) ---
BOTTRADE_PORT=8501

# =============================================================================
# Multi-tenancy / billing  (see saas/plans.py)
# =============================================================================

# How much of YOUR key a free-tier user may spend per month, in USD, before
# AI modes lock and they are asked to bring their own key. COMMITTEE mode is
# unaffected — it never calls the API, so it stays free and unlimited.
#
# Set to 0 to make the free tier strictly zero-cost to you.
#
# The budget is per account, so it is only enforceable when the app can tell
# users apart — that means OIDC sign-in (`[auth]` in .streamlit/secrets.toml,
# DEPLOY.md section 2b). Under the shared-password gate or with no auth at
# all, every visitor is one account and this is a single pool for the whole
# deployment; the Settings page warns the host when that is the case.
BOTTRADE_FREE_BUDGET_USD=0.25

# How many live trading bots this process will run at once. When full, a NEW
# user is refused a slot rather than an existing bot being evicted - evicting
# would silently stop someone's trading and leave their stop-loss unwatched.
#
# Measure before changing:  python -m tools.loadtest_engines
# On the dev machine: ~7 CPU-bound cycles/sec regardless of bot count, and
# 55 KB per idle engine - roughly 210 bots at a 30s interval before CPU
# saturates. Yahoo/Anthropic rate limits will bite long before that.
BOTTRADE_MAX_LIVE_ENGINES=100

# =============================================================================
# Billing (Stripe)  (see saas/billing.py)
# =============================================================================
#
# Unset by default: billing is disabled and every account stays on the Free
# plan. Set all three of the following to accept real payments. See DEPLOY.md
# for the full walkthrough (creating the two recurring Prices in the Stripe
# Dashboard, test mode vs. live mode, and what "Pick what you need" vs.
# Managed Payments means during onboarding).
#
# Test mode first: use your sk_test_... key and test-mode Price IDs, pay with
# Stripe's test card 4242 4242 4242 4242, confirm the full flow, THEN switch
# to live keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_DESK=price_...

# Not required. v1 does not run a webhook receiver - it reconciles
# subscription state by polling Stripe on a 5-minute TTL instead (see
# sync_subscription_status in saas/billing.py). Set this only if you later
# add a webhook endpoint and want to verify Stripe's signature on it.
# STRIPE_WEBHOOK_SECRET=whsec_...

# The real origin this dashboard is reachable at - used to build the
# Checkout success/cancel redirect URLs. Must be the actual deployed HTTPS
# origin in production; localhost only works when testing on your own machine.
BOTTRADE_BASE_URL=http://localhost:8501
