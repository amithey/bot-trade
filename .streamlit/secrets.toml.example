# =============================================================================
# BotTrade — Streamlit secrets
#
# Copy to `.streamlit/secrets.toml` and fill in. NEVER commit the real file;
# it is gitignored because it holds your OAuth client secret.
#
# Presence of the [auth] block is what switches BotTrade into real per-person
# accounts (`oidc` mode). Without it the app runs in shared-password or open
# mode, where every visitor is one account — see dashboard/_identity.py.
#
# Requires:  pip install "Authlib>=1.3.2"
# =============================================================================

[auth]
# Must exactly match the redirect URI registered with your provider, and must
# end in /oauth2callback. Use your real https:// origin in production.
redirect_uri = "http://localhost:8501/oauth2callback"

# Signs the login cookie. Any long random string; changing it signs everyone
# out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

# --- Single provider (simplest) ---------------------------------------------
# Google: console.cloud.google.com → APIs & Services → Credentials →
#         Create OAuth client ID → Web application. Add the redirect_uri above
#         to "Authorised redirect URIs".
client_id = "REPLACE.apps.googleusercontent.com"
client_secret = "REPLACE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Or several providers ----------------------------------------------------
# Delete the four single-provider keys above and use named sections instead.
# BotTrade renders one sign-in button per section.
#
# [auth.google]
# client_id = "...apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# [auth.auth0]
# Auth0 is the easy route if you want email+password signup as well as social
# login — it speaks OIDC, so nothing here changes.
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://YOUR_TENANT.auth0.com/.well-known/openid-configuration"
